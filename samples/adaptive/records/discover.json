{
  "schema": "pocketroot.exploit.v1",
  "cve": "FIXTURE-DISCOVER",
  "target": "127.0.0.1:8080",
  "effect": "read_file",
  "params": [],
  "steps": [
    {
      "name": "read",
      "method": "GET",
      "path": "/discover?f={{file}}",
      "expect_status": 200,
      "capture": {
        "name": "route",
        "prefix": "route=",
        "suffix": ";"
      }
    }
  ],
  "expect_contains": "",
  "module": {
    "id": "discover",
    "priority": 0,
    "requires": [
      {
        "fact": "service",
        "equals": "http"
      }
    ],
    "inputs": [
      {
        "name": "file",
        "fact": "target_file",
        "default": "/etc/passwd"
      }
    ],
    "outputs": [
      {
        "fact": "route",
        "capture": "route",
        "transform": "trim"
      }
    ]
  }
}
